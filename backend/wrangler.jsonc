{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kidprompt-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kidprompt-db",
      // MUST match admin/wrangler.jsonc's database_id exactly.
      "database_id": "6f3dce2f-0e30-4944-b564-55deee368b33"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      // Signup codes. kidprompt.ai must be onboarded to Cloudflare Email
      // Sending (npx wrangler email sending enable kidprompt.ai) first.
      "allowed_sender_addresses": ["verify@kidprompt.ai"]
    }
  ],
  "vars": {
    // Daily AI builds per grown-up account (all their kids together).
    "DAILY_BUILD_LIMIT": "25",
    // Build model. Sonnet 5.5 for speed and half the cost of the code default
    // (claude-opus-5-5 in src/lib/claude.ts). Delete this line to go back to Opus.
    "CLAUDE_MODEL": "claude-sonnet-5-5",
    // "Try it" without an account (src/lib/guest.ts): one free build per guest,
    // then an account is needed for more. Also guest builds per IP per 24h
    // (a few devices on one home network) and all guest builds per 24h (the
    // cost ceiling: about $0.10 each on Sonnet 5.5).
    "GUEST_BUILD_LIMIT": "1",
    "GUEST_IP_DAILY_LIMIT": "3",
    "GUEST_GLOBAL_DAILY_LIMIT": "60"
  },
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/* is the Hono app, /play/* serves a game's html in a sandbox.
    // Everything else is the SPA straight from the edge.
    "run_worker_first": ["/api/*", "/play/*"]
  },
  "dev": {
    "port": 8787
  },
  "routes": [
    { "pattern": "kidprompt.ai", "custom_domain": true }
  ]
}
